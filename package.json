{
  "name": "@brashkie/signalis-core",
  "version": "0.4.8",
  "description": "Cryptographic primitives for Signal Protocol \u2014 Rust-powered Node.js library with Ed25519, XEd25519, Curve25519, HKDF, AES-GCM (with AAD), AES-CBC, ChaCha20-Poly1305, HMAC, SHA-256 (ESM + CJS + TypeScript). Android arm64/armv7 support.",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "preartifacts": "node scripts/create-npm-dirs.js",
    "artifacts": "napi artifacts",
    "build:native": "napi build --platform --release --cargo-cwd crates/sc-node --js index.js --dts index.d.ts",
    "build:native:debug": "napi build --platform --cargo-cwd crates/sc-node --js index.js --dts index.d.ts",
    "build:ts": "tsup",
    "build": "npm run build:native && npm run build:ts",
    "build:debug": "npm run build:native:debug && npm run build:ts",
    "test": "npm run test:rust && npm run test:vitest && npm run test:dual",
    "test:vitest": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run",
    "test:watch": "cross-env VITE_CJS_IGNORE_WARNING=true vitest",
    "test:rust": "cargo test --workspace --exclude sc-node",
    "test:dual": "node __tests__/cjs.test.cjs && node __tests__/esm.test.mjs",
    "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --coverage",
    "test:coverage:ui": "cross-env VITE_CJS_IGNORE_WARNING=true vitest --coverage --ui",
    "coverage:open": "node -e \"require('child_process').exec(process.platform==='win32'?'start coverage/index.html':process.platform==='darwin'?'open coverage/index.html':'xdg-open coverage/index.html')\"",
    "example:cjs": "node examples/cjs-example.cjs",
    "example:esm": "node examples/esm-example.mjs",
    "example:ts": "tsx examples/ts-example.ts",
    "example:signing": "node examples/signing.mjs",
    "example:aad": "node examples/aad.mjs",
    "example:e2e": "node examples/e2e-channel.mjs",
    "examples": "npm run example:cjs && npm run example:esm && npm run example:ts && npm run example:signing && npm run example:aad && npm run example:e2e",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"__tests__/**/*.ts\"",
    "format:rust": "cargo fmt --all",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "clean": "node -e \"const fs=require('fs');['dist','target','index.js','index.d.ts'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}));fs.readdirSync('.').filter(f=>f.endsWith('.node')).forEach(f=>fs.rmSync(f,{force:true}));console.log('\u2713 Cleaned')\"",
    "version": "napi version"
  },
  "files": [
    "dist/",
    "index.js",
    "index.d.ts",
    "README.md",
    "README.es.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "MIGRATION.md",
    "SECURITY.md"
  ],
  "keywords": [
    "signal-protocol",
    "e2e-encryption",
    "cryptography",
    "curve25519",
    "ed25519",
    "xed25519",
    "x25519",
    "ecdh",
    "diffie-hellman",
    "hkdf",
    "aes-gcm",
    "aes-cbc",
    "aead",
    "hmac",
    "sha256",
    "digital-signature",
    "rust",
    "napi",
    "native",
    "esm",
    "commonjs",
    "dual-package",
    "hepein"
  ],
  "author": "Brashkie (Hepein)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brashkie/signalis-core.git"
  },
  "bugs": {
    "url": "https://github.com/Brashkie/signalis-core/issues"
  },
  "homepage": "https://github.com/Brashkie/signalis-core#readme",
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "name": "signalis-core",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-linux-android",
        "armv7-linux-androideabi",
        "x86_64-linux-android"
      ]
    }
  },
  "optionalDependencies": {
    "@brashkie/signalis-core-win32-x64-msvc": "0.4.8",
    "@brashkie/signalis-core-win32-arm64-msvc": "0.4.8",
    "@brashkie/signalis-core-darwin-x64": "0.4.8",
    "@brashkie/signalis-core-darwin-arm64": "0.4.8",
    "@brashkie/signalis-core-linux-x64-gnu": "0.4.8",
    "@brashkie/signalis-core-linux-x64-musl": "0.4.8",
    "@brashkie/signalis-core-linux-arm64-gnu": "0.4.8",
    "@brashkie/signalis-core-android-arm64": "0.4.8",
    "@brashkie/signalis-core-android-arm-eabi": "0.4.8",
    "@brashkie/signalis-core-android-x64": "0.4.8"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
